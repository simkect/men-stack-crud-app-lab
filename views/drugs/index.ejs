<!-- views/fruits/index.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Drugs Index</title>
</head>

<body>
  <h1>All Drugs</h1>
  <a href="/drugs/new">Add New Drug</a>
  <ul>
    <% drugs.forEach((drugObj) => { %>
      <li>
        <a href="/drugs/<%= drugObj._id %>"><%= drugObj.name %> </a>
      </li>
      <% }) %>
  </ul>
</body>

</html>