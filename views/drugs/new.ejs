<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create a Fruit</title>
</head>

<!-- views/fruits/new.ejs -->

<body>
  <a href="/drugs/">Back to Fruits</a>
  <h1>Create a New Drug!</h1>

  <form action="/drugs" method="POST">
    <label for="name">Name:</label>
    <input type="text" name="name" id="name"/>
    <label for="typeOfDrug">Name:</label>
    <input type="text" name="typeOfDrug" id="typeOfDrug"  />
    <label for="consequences">Name:</label>
    <input type="text" name="consequences" id="consequences" />
    <label for="distribution">Name:</label>
    <input type="text" name="distribution" id="distribution"/>

    <button type="submit">Add Drug</button>
  </form>
</body>


</html>